# ─────────────────────────────────────────────────────────────
# SocialHub Pro — environment configuration
# Copy to .env and fill in what you have. The app boots and is
# fully usable with NOTHING set here (local SQLite + sandbox
# publishing + local template AI).
# ─────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
# Public origin used for OAuth redirects and absolute links.
APP_ORIGIN=http://localhost:3000
# 32+ char random string. Encrypts OAuth access tokens at rest.
APP_ENCRYPTION_KEY=
# Shared secret for the background worker service (Bearer auth on /api/v1/scheduler/tick).
WORKER_SECRET=
# Absolute path for the SQLite database file (default: ./data/socialhub.db)
DATABASE_PATH=
# Local upload directory (default: ./storage/uploads)
STORAGE_DIR=
# Seed the demo workspace + demo dataset on first boot (true/false)
SEED_DEMO=true

# ── Machine-to-machine scheduler ──────────────────────────────
# In-process scheduler inside the Next server (default true).
ENABLE_INPROCESS_SCHEDULER=true
# Tick interval in seconds for the publishing engine.
SCHEDULER_INTERVAL_SECONDS=20

# ── Meta / Facebook + Instagram Graph API ─────────────────────
# https://developers.facebook.com/apps  → App settings → Basic
META_APP_ID=
META_APP_SECRET=
# Must include https://<APP_ORIGIN>/api/v1/integrations/meta/callback
META_REDIRECT_URI=http://localhost:3000/api/v1/integrations/meta/callback
# e.g. v23.0 — see https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_VERSION=v23.0
# Shared secret you type into Meta App Dashboard → Webhooks → Verify token
META_WEBHOOK_VERIFY_TOKEN=
# Enable Facebook Login for Business / Instagram Login flows (true/false)
META_ENABLE_FACEBOOK_LOGIN=true
META_ENABLE_INSTAGRAM_LOGIN=true

# ── AI providers (all optional) ───────────────────────────────
# Ollama for zero-cost local inference: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Any OpenAI-compatible endpoint (optional, paid)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Order of preference: ollama | openai | template
AI_PROVIDER_ORDER=ollama,openai,template

# ── Optional email delivery for notifications/reports ─────────
# Leave empty to keep notifications in-app only.
SMTP_URL=
SMTP_FROM=SocialHub Pro <no-reply@example.com>

# ── Supabase (production Postgres path) ───────────────────────
# See docs/DEPLOYMENT.md for switching DATABASE_PROVIDER to Postgres.
DATABASE_PROVIDER=sqlite
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
